---
interface Props {
  title?: string;
}
const { title = "Aleix Alcacer" } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Personal website of Aleix Alcacer Sales — Postdoctoral researcher at Universitat Jaume I." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <nav>
      <div class="nav-inner">
        <a href="/" class="nav-name">Aleix Alcacer</a>
        <ul class="nav-links">
          <li><a href="/" class={path === "/" ? "active" : ""}>About</a></li>
          <li><a href="/research" class={path === "/research" ? "active" : ""}>Research</a></li>
          <li><a href="/teaching" class={path === "/teaching" ? "active" : ""}>Teaching</a></li>
          <li><a href="/projects" class={path === "/projects" ? "active" : ""}>Projects</a></li>
        </ul>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <div class="container">
        © {new Date().getFullYear()} Aleix Alcacer Sales
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
