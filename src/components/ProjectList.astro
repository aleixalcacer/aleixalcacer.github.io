---
interface Link { label: string; url: string; }
interface ProjectItem {
  title: string;
  description?: string;
  meta?: (string | null | undefined | false)[];
  links?: Link[];
}
interface Props { items: ProjectItem[]; }
const { items } = Astro.props;
---

{items.length ? (
  <ul class="item-list">
    {items.map((item) => {
      const meta = (item.meta ?? []).filter(Boolean) as string[];
      return (
        <li class="item">
          <p class="item-title">{item.title}</p>
          {item.description && <p class="item-desc">{item.description}</p>}
          {meta.length > 0 && (
            <div class="item-meta">
              {meta.map((s) => <span>{s}</span>)}
            </div>
          )}
          {item.links && item.links.length > 0 && (
            <div class="hero-links" style="margin-top:0.6rem">
              {item.links.map((l) => (
                <a class="hero-link" href={l.url} target="_blank" rel="noopener">{l.label}</a>
              ))}
            </div>
          )}
        </li>
      );
    })}
  </ul>
) : <p class="empty-note">No entries yet.</p>}
