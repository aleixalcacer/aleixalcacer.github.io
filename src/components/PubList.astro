---
interface PubItem {
  authors?: string;
  year?: string;
  title: string;
  doi?: string;
  venue?: string;
  venuePrefix?: string;
  venueSuffix?: string;
}
interface Props { items: PubItem[]; }
const { items } = Astro.props;
---

{items.length ? (
  <ul class="item-list">
    {items.map((pub) => (
      <li class="item">
        {pub.authors
          ? <span class="pub-meta">{pub.authors} ({pub.year}). </span>
          : pub.year && <span class="pub-meta">({pub.year}). </span>
        }
        <span class="item-title" style="display:inline; font-weight:500">
          {pub.doi
            ? <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener">{pub.title}</a>
            : pub.title
          }.
        </span>
        {(pub.venuePrefix || pub.venue || pub.venueSuffix) && (
          <> <span class="pub-meta">
            {pub.venuePrefix}<em class="pub-venue">{pub.venue}</em>{pub.venueSuffix}.
          </span></>
        )}
        {pub.doi && (
          <> <a class="pub-doi" href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener">doi:{pub.doi}</a></>
        )}
      </li>
    ))}
  </ul>
) : <p class="empty-note">No entries yet.</p>}
