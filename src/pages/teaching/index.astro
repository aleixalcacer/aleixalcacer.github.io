---
import Layout from "../../layouts/Layout.astro";
import cv from "../../data/cv.json";
import Group from "../../components/Group.astro";
import ProjectList from "../../components/ProjectList.astro";
import AwardList from "../../components/AwardList.astro";
import PubList from "../../components/PubList.astro";

const { teaching, theses, teaching_training, teaching_projects,
        teaching_articles, teaching_conferences, teaching_others, awards } = cv;

const thesisItems = theses.map((t: any) => ({
  title: t.title,
  meta: [t.institution || undefined, t.end || undefined],
}));

const teachingProjectItems = teaching_projects.map((p: any) => ({
  title: p.title,
  meta: [p.institution, p.end || undefined],
}));

const awardItems = awards.map((a) => ({
  title: a.title,
  year: a.year || undefined,
  meta: a.institution,
  description: a.description || undefined,
}));

const trainingItems = teaching_training.map((t) => ({
  title: t.title,
  meta: [t.institution, t.hours && `${t.hours} h`],
}));

const teachingArticleItems = teaching_articles.map((p) => ({
  authors: p.authors || undefined,
  year: p.year,
  title: p.title,
  doi: (p as any).doi || undefined,
  venue: p.journal || undefined,
}));

const teachingConferenceItems = teaching_conferences.map((p) => ({
  authors: p.authors || undefined,
  year: p.year,
  title: p.title,
  venue: p.conference || undefined,
}));

const teachingOtherItems = teaching_others.map((p) => ({
  authors: p.authors || undefined,
  year: p.year,
  title: p.title,
  venue: (p as any).venue || undefined,
}));
---

<Layout title="Teaching — Aleix Alcacer">
  <section id="teaching">
    <div class="container">
      <p class="section-title">Teaching</p>

      <Group title="Courses Taught">
        {teaching.length ? (
          <table class="teaching-table">
            <thead>
              <tr>
                <th>Course</th>
                <th>Degree</th>
                <th>ECTS</th>
                <th>Year</th>
              </tr>
            </thead>
            <tbody>
              {teaching.map((t) => (
                <tr>
                  <td>{t.course}</td>
                  <td>{t.degree}</td>
                  <td>{t.credits}</td>
                  <td>{t.year}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p class="empty-note">No entries yet.</p>
        )}
      </Group>

      <Group title="Thesis & Project Supervision">
        <ProjectList items={thesisItems} />
      </Group>

      <Group title="Teaching Innovation Projects">
        <ProjectList items={teachingProjectItems} />
      </Group>

      <Group title="Teaching Publications">
        <p class="subgroup-title">Articles</p>
        <PubList items={teachingArticleItems} />
        <p class="subgroup-title">Teaching Conferences</p>
        <PubList items={teachingConferenceItems} />
        <p class="subgroup-title">Other Teaching Publications</p>
        <PubList items={teachingOtherItems} />
      </Group>

      <Group title="Awards & Distinctions">
        <AwardList items={awardItems} />
      </Group>

      <Group title="Teaching Development Courses">
        <ProjectList items={trainingItems} />
      </Group>
    </div>
  </section>
</Layout>
