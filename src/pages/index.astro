---
import Layout from "../layouts/Layout.astro";
import cv from "../data/cv.json";

const { experience, education, languages } = cv;
---

<Layout>
  <section id="about">
    <div class="container">
      <div class="hero">
        <img
          class="hero-photo"
          src="/profile.jpg"
          alt="Aleix Alcacer Sales"
          width="120"
          height="120"
        />
        <div>
          <h1 class="hero-name">Aleix Alcacer Sales</h1>
          <p class="hero-role">
            Postdoctoral Researcher · <span>Universitat Jaume I</span>
          </p>
          <p class="hero-bio">
            I work on archetypal analysis, statistical learning, and open-source
            scientific software. My research focuses on developing novel methods
            for high-dimensional data representation and fair machine learning.
          </p>
          <div class="hero-links">
            <a class="hero-link" href="https://github.com/aleixalcacer" target="_blank" rel="noopener">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
              GitHub
            </a>
            <a class="hero-link" href={`https://orcid.org/${cv.personal.orcid}`} target="_blank" rel="noopener">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.016-5.325 5.016h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 3.872-2.484 3.872-3.722 0-2.016-1.284-3.722-3.872-3.722h-2.297z"/></svg>
              ORCID
            </a>
            <a class="hero-link" href="https://www.linkedin.com/in/aleixalcacer" target="_blank" rel="noopener">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
            <a class="hero-link" href="mailto:aalcacer@uji.es">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7 10-7"/></svg>
              Email
            </a>
            <a class="hero-link" href={`https://cvn.fecyt.es/${cv.personal.orcid}`} target="_blank" rel="noopener">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10,9 9,9 8,9"/></svg>
              CV
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="experience">
    <div class="container">
      <p class="section-title">Professional Experience</p>
      <ul class="timeline">
        {experience.map((e) => (
          <li class="timeline-item">
            <span class="timeline-date">
              {e.start} – {e.end || "present"}
            </span>
            <div>
              <p class="timeline-role">{e.role}</p>
              <p class="timeline-where">{e.institution}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="education">
    <div class="container">
      <p class="section-title">Education</p>
      <ul class="item-list">
        {education.map((e) => (
          <li class="item">
            <p class="item-title">{e.degree}</p>
            <p class="item-meta">
              {e.institution}{e.end ? ` · ${e.end}` : ""}
            </p>
            {e.thesis && <p class="item-desc">Thesis: {e.thesis}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="languages">
    <div class="container">
      <p class="section-title">Languages</p>
      {languages.length ? (
        <ul class="lang-list">
          {[...languages].sort((a, b) => b.level.localeCompare(a.level)).map((l) => (
            <li class="lang-item">
              {l.name} <span class="lang-level">{l.level}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-note">No entries yet.</p>
      )}
    </div>
  </section>
</Layout>
